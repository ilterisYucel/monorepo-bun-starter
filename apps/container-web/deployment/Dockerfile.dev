FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598

WORKDIR /app

# Tüm projeyi kopyala
COPY . .

# Root'da install yap (tüm workspace'leri çözer)
# Electron binary indirmeyi atla — container-web'in ihtiyacı yok
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 PUPPETEER_SKIP_DOWNLOAD=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN bun install

WORKDIR /app/apps/container-web

CMD ["bun", "run", "dev"]
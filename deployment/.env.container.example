# Container stack ortam degiskenleri sablonu — commit'lenir (sirlar YOK).
# Kopyalayip doldurun:  cp .env.container.example .env.container
# Script'ler dosyayi su sekilde kullanir:
#   docker compose --env-file deployment/.env.container -f deployment/docker-compose.container.yml up -d

# Web-service kimlik dogrulamasi + konteyner oturum JWT'si (>=32 karakter):
#   openssl rand -hex 32
JWT_SECRET=

# FieldConnector bootstrap (Faz 2).
# FIELD_CONNECT_ENABLED=true ise FIELD_WS_URL + CONTAINER_TOKEN zorunludur
# (eksikse fail-fast acilis reddi). false ise konnektor hic acilmaz.
FIELD_CONNECT_ENABLED=false
# Field WS URL — ana + yedek virgulle ayrilabilir; /ws/container YOLU zorunludur:
FIELD_WS_URL=wss://field.example.com/ws/container

# Konteyner service token'i — kurulumda uretilir ve field register API'sine
# kaydedilir (field yalnizca SHA-256 hash'ini saklar).
#   openssl rand -hex 32
CONTAINER_TOKEN=

# Field registry'deki kayitla eslesmesi gereken benzersiz kimlik.
CONTAINER_ID=container-1

# --- BSC→PCS connector BMS hedefi (BSC-PCS-CONNECTOR-MIMARISI §6) ---
# Standalone: field stack host'ta kosuyorsa host.docker.internal (varsayilan).
# Ayni docker ağı içi (aws-edge) kullanilacaksa compose zaten field-device-service
# atar — buradan ezmeye gerek yok.
#PCS_BMS_TARGET_HOST=host.docker.internal
#PCS_BMS_TARGET_PORT=15502

# Faz 3 — tünel loopback upstream'leri (opsiyonel).
# DEV: compose default'ları — TUNNEL_API_UPSTREAM=http://web-service:5001,
# TUNNEL_STATIC_UPSTREAM=http://web-static:80 (build edilmiş SPA — ön koşul:
# nx run container-web:build). URETIM: nginx web:80.
#TUNNEL_API_UPSTREAM=
#TUNNEL_STATIC_UPSTREAM=

# Management (otomasyon) servisi — MANAGEMENT-SERVICE-MIMARISI.md.
# Kural degerlendirme araligi (ms) — varsayilan 10000.
#MANAGEMENT_EVALUATION_INTERVAL_MS=10000

# Yonetim servisi log seviyesi (debug|info|warn|error) — varsayilan info.
#LOG_LEVEL=info

# AWS Boss ortam degiskenleri sablonu — commit'lenir (sirlar YOK).
# Kopyalayip doldurun:  cp .env.aws-boss.example .env.aws-boss
# Kullanim:
#   docker compose --env-file deployment/.env.aws-boss -f deployment/docker-compose.aws-boss.yml up -d --build
#
# FLAG (TLS): Field uplink su an ws:// (TLS'siz) — DEMO KABULU. Uretimde
# wss:// + ALB/nginx + ACM zorunlu. (docs/process/AWS-DEPLOYMENT.md)

# --- Web-service kimlik dogrulamasi (>=32 karakter) ---
#   openssl rand -hex 32
JWT_SECRET=

# --- Seed kullanicilari (>=8 karakter) ---
# Ilk girislerde zorunlu sifre degisimi istenir.
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# Faz 6 T6.1 — MFA zorunlulugu. FLAG: demo'da false (TOTP yok),
# üretim geçişinde true yapılmalı.
MFA_ENABLED=false

# --- Faz 5: lab gorselligi ---
# Demo sunumlarinda true (ornek bildirimler); uretimde false.
FIELD_EVENTS_DEMO_SEED=false

# --- Faz 4: WireGuard yedek yol (OPSIYONEL — FLAG) ---
# Bos birakilirsa modul kurulmaz (demo kapali). Etkinlestirilecekse:
#   wg genkey
WG_CLIENT_PRIVATE_KEY=
WG_CLIENT_ADDRESS=10.99.0.2/32
WG_ALLOWED_IPS=10.0.0.0/8
WG_CONFIG_DIR=/etc/wireguard

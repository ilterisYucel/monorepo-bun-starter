{
  "rules": [
    {
      "name": "r06_recovery",
      "enabled": true,
      "cooldownMs": 60000,
      "when": {
        "all": [
          {
            "device": {
              "ids": [
                "PCS-1"
              ]
            },
            "telemetry": "Emergency Stop Button Status",
            "op": "eq",
            "threshold": 0,
            "debounceMs": 2000
          },
          {
            "device": {
              "ids": [
                "PCS-1"
              ]
            },
            "telemetry": "PCS Fault Status",
            "op": "eq",
            "threshold": 0
          }
        ]
      },
      "then": [
        {
          "action": "maneuver",
          "name": "fl06_recovery"
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "auto_rule_r06_recovery",
          "message": "FL-06 Recovery: E-stop kalkti — sistem Standby'a dondu (manevra delegasyonu)"
        },
        {
          "action": "notify"
        }
      ]
    },
    {
      "name": "soc_discharge_example",
      "enabled": false,
      "cooldownMs": 300000,
      "when": {
        "all": [
          {
            "device": {
              "ids": [
                "PCS-1"
              ]
            },
            "telemetry": "Grid Active Power",
            "op": "gte",
            "threshold": 100
          }
        ]
      },
      "then": [
        {
          "action": "operation",
          "name": "field_discharge",
          "params": {
            "powerKw": 200
          }
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "auto_rule_soc_discharge"
        },
        {
          "action": "notify"
        }
      ]
    },
    {
      "name": "demo_full_charge_rest",
      "enabled": true,
      "cooldownMs": 600000,
      "when": {
        "all": [
          {
            "device": {
              "ids": ["PCS-1"]
            },
            "telemetry": "Battery Pack SOC",
            "op": "gte",
            "threshold": 97,
            "debounceMs": 3000
          }
        ]
      },
      "then": [
        {
          "action": "operation",
          "name": "standby"
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "demo_full_charge_rest",
          "message": "Demo: SOC >= 97 — tam şarj sonrası dinlenmeye geçildi"
        }
      ]
    },
    {
      "name": "demo_full_discharge_rest",
      "enabled": true,
      "cooldownMs": 600000,
      "when": {
        "all": [
          {
            "device": {
              "ids": ["PCS-1"]
            },
            "telemetry": "Battery Pack SOC",
            "op": "lte",
            "threshold": 3.5,
            "debounceMs": 3000
          }
        ]
      },
      "then": [
        {
          "action": "operation",
          "name": "standby"
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "demo_full_discharge_rest",
          "message": "Demo: SOC <= 3,5 — tam deşarj sonrası dinlenmeye geçildi"
        }
      ]
    }
  ]
}

# AWS Edge (container+field) ortam degiskenleri sablonu — commit'lenir (sirlar YOK).
# Kopyalayip doldurun:  cp .env.aws-edge.example .env.aws-edge
# Kullanim:
#   docker compose --env-file deployment/.env.aws-edge -f deployment/docker-compose.aws-edge.yml up -d --build
#
# FLAG (TLS): Asagidaki WS baglantilari su an ws:// (TLS'siz) — DEMO KABULU.
# Uretime cikarken wss:// + ALB/nginx + ACM zorunlu; service token'lari duz WS
# uzerinde tasinmamali. (docs/process/AWS-DEPLOYMENT.md)

# --- Container web-service kimlik dogrulamasi (>=32 karakter) ---
#   openssl rand -hex 32
JWT_SECRET=

# --- Field web-service kimlik dogrulamasi (>=32 karakter, CONTAINER'DAN FARKLI) ---
#   openssl rand -hex 32
FIELD_JWT_SECRET=

# --- Field seed kullanicilari (>=8 karakter) ---
# Ilk girislerde zorunlu sifre degisimi istenir.
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# --- Tek saha kimligi (field tier ZORUNLU, gecerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha

# Faz 6 T6.1 — MFA zorunlulugu. FLAG: demo'da false (TOTP yok),
# üretim geçişinde true yapılmalı.
MFA_ENABLED=false

# --- Konteyner → field baglantisi (Faz 2 FieldConnector) ---
FIELD_CONNECT_ENABLED=true
# Network ici servis adi (merged compose) — TLS yoksa ws:// kalir.
FIELD_WS_URL=ws://field-web-service:5002/ws/container
# Konteyner service token'i — field register API'sine kaydedilir
# (field yalnizca SHA-256 hash'ini saklar):
#   openssl rand -hex 32
CONTAINER_TOKEN=
CONTAINER_ID=container-1

# --- Field → boss uplink (Boss Faz 3) ---
FIELD_UPLINK_ENABLED=true
# Boss EC2 adresi — IP'yi siz doldurun:
#   ws://<BOSS_EC2_IP>:5003/ws/field
FIELD_UPLINK_WS_URL=
# Field uplink service token'i — boss tarafinda saha kaydinda verilir
# (POST /api/admin/fields body.uplinkToken; boss yalnizca hash saklar):
#   openssl rand -hex 32
FIELD_UPLINK_TOKEN=

# --- Tünel loopback upstream'leri (AWS adlandirmalı; normalde gerekmez) ---
#TUNNEL_API_UPSTREAM=http://container-web-service:5001
#TUNNEL_STATIC_UPSTREAM=http://container-web:80
#TUNNEL_FIELD_API_UPSTREAM=http://field-web-service:5002
#TUNNEL_FIELD_STATIC_UPSTREAM=http://field-web:80

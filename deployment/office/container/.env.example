# Office / RevPi — container tier ortam değişkenleri ŞABLONU (commit'lenir; sır YOK).
# Kopyalayıp doldurun:  cp .env.example .env
# Kullanım:
#   docker compose --env-file deployment/office/container/.env \
#     -f deployment/office/container/docker-compose.yml up -d --build

CONTAINER_ID=Revpi-1
MFA_ENABLED=false

# --- Sırlar (openssl rand -hex 32 ile üretin) ---
JWT_SECRET=
CONTAINER_TOKEN=

# --- Seed şifreleri (>=8 karakter) ---
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# --- Harici TimescaleDB (office DB sunucusu; compose varsayılanları bunlarla aynı) ---
POSTGRES_HOST=192.168.1.113
POSTGRES_PORT=5432
POSTGRES_USER=revpi
POSTGRES_PASSWORD=GD-Energy-2026
POSTGRES_DATABASE=ems

# --- Opsiyonel ---
FIELD_CONNECT_ENABLED=false
# LOG_LEVEL=info
# MANAGEMENT_EVALUATION_INTERVAL_MS=10000
# PCS_BMS_TARGET_HOST=host.docker.internal

# Boss stack ortam degiskenleri sablonu — commit'lenir (sirlar YOK).
# Kopyalayip doldurun:  cp .env.boss.example .env.boss
# Script'ler dosyayi su sekilde kullanir:
#   docker compose --env-file deployment/.env.boss -f deployment/docker-compose.boss.dev.yml up -d

# Web-service kimlik dogrulamasi (>=32 karakter, rastgele uretin:
#   openssl rand -hex 32)
JWT_SECRET=

# Faz 6 T6.1 MFA anahtari: true = zorunlu (URETIM), false = kapali (debug).
MFA_ENABLED=true

# Seed kullanicilarinin ilk parolalari (>=8 karakter).
# Ilk girislerde zorunlu sifre degisimi istenir (Faz 1 T1.6).
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

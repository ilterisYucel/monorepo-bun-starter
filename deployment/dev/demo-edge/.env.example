# DEMO-FIELD yerel demo/entegrasyon stack'i ortam değişkenleri şablonu.
# Kopyalayın ve doldurun (sırlar commit'lenmez):
#   cp deployment/dev/demo-edge/.env.example deployment/dev/demo-edge/.env
# Kullanım:
#   bun run start:demo-integration
#   bun run test:demo-integration
#   bun run stop:demo-integration
#
# UI'suz konteyner + field backend + demo-field SPA (tek network).
# SPA: http://localhost:8088 · API: http://localhost:5002

# --- Tek saha kimliği (ZORUNLU, geçerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha Demo

# --- JWT sırları (>=32 karakter, BİRBİRİNDEN FARKLI) ---
#   openssl rand -hex 32
# Konteyner web-service:
JWT_SECRET=
# Field web-service:
FIELD_JWT_SECRET=

# --- Seed kullanıcı parolaları (>=8 karakter) ---
# Entegrasyon testleri varsayılanı: admin / password123
SEED_ADMIN_PASSWORD=password123
SEED_BOSS_PASSWORD=password123
SEED_GUEST_PASSWORD=password123

# MFA — demo'da kapalı (TOTP yok).
MFA_ENABLED=false

# --- Konteyner → field bağlantısı (gerçek senaryo; aynı network DNS) ---
FIELD_CONNECT_ENABLED=true
FIELD_WS_URL=ws://field-web-service:5002/ws/container
# Konteyner service token'ı — field register API'sine kaydedilir:
#   openssl rand -hex 32
CONTAINER_TOKEN=
CONTAINER_ID=container-1

# --- BSC→PCS connector BMS hedefi (servis DNS — host portu gerekmez) ---
PCS_BMS_TARGET_HOST=field-device-service
# Connector-1 hedefi; BSC-2 connector'ı connector.sim.target ile 15503'e gider.
PCS_BMS_TARGET_PORT=15502

# --- Boss uplink — demo standalone, KAPALI ---
FIELD_UPLINK_ENABLED=false
FIELD_UPLINK_WS_URL=
FIELD_UPLINK_TOKEN=

# --- Field → konteyner komut kanalı (opsiyonel) ---
FIELD_INTERNAL_API_TOKEN=

# --- İLK KURULUM: konteyneri field'a kaydet (bir kez) ---
# Konteyner WS uplink'i register OLMADAN bağlanamaz (101 reddi). Stack kalktıktan
# sonra (field web-service ayakta):
#   FID=$(grep '^FIELD_ID=' deployment/dev/demo-edge/.env | cut -d= -f2)
#   CT=$(grep '^CONTAINER_TOKEN=' deployment/dev/demo-edge/.env | cut -d= -f2)
#   T=$(curl -s -X POST http://localhost:5002/api/auth/login -H 'Content-Type: application/json' \
#       -d '{"username":"admin","password":"password123"}' | python3 -c 'import sys,json;print(json.load(sys.stdin)["accessToken"])')
#   # admin ilk girişte parola değiştirir; yeni parola ile tekrar login edip T'yi alın.
#   curl -X POST "http://localhost:5002/api/fields/$FID/containers/container-1/register" \
#       -H "Authorization: Bearer $T" -H 'Content-Type: application/json' -d "{\"token\":\"$CT\"}"
#   docker restart demo-container-web-service   # uplink'i hemen yeniden kurar


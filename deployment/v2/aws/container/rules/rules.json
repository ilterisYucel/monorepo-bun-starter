          {
            "telemetry": "Battery Pack SOC",
            "op": "gte",
            "threshold": 1000
          }
        ]
      },
      "then": [
        {
          "action": "log",
          "level": "info",
          "eventCode": "demo_noop",
          "message": "demo no-op (kurallar test edilmedi — devre dışı)"
        }
      ]
    }
  ]
}

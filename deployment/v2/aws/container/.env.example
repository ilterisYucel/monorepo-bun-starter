# AWS Edge (DEMO-FIELD / v2) — CONTAINER yarısı ortam şablonu — commit'lenir (sırlar YOK).
# Kopyalayıp doldurun:
#   cp deployment/v2/aws/container/.env.example deployment/v2/aws/container/.env
# Kullanım (önce container ağı tanımlar, sonra field):
#   docker compose --env-file deployment/v2/aws/container/.env -f deployment/v2/aws/container/docker-compose.yml up -d --build
#
# FLAG (TLS): FIELD_WS_URL şu an ws:// (TLS'siz) — DEMO KABULÜ. Üretimde
# wss:// + ALB/nginx + ACM zorunlu. (docs/process/AWS-DEPLOYMENT.md)

# --- Container web-service kimlik doğrulaması (>=32 karakter) ---
#   openssl rand -hex 32
JWT_SECRET=

# --- Seed kullanıcıları (>=8 karakter) ---
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# Faz 6 T6.1 — MFA. FLAG: demo'da false (TOTP yok), üretimde true.
MFA_ENABLED=false

# --- Container → field bağlantısı (ortak edge-network servis adı) ---
FIELD_CONNECT_ENABLED=true
FIELD_WS_URL=ws://field-web-service:5002/ws/container
# Container service token'ı — field register API'sine kaydedilir (hash saklanır):
#   openssl rand -hex 32
CONTAINER_TOKEN=
CONTAINER_ID=container-1

# --- BSC→PCS connector BMS hedefi (ortak edge-network servis adı) ---
#PCS_BMS_TARGET_HOST=field-device-service
#PCS_BMS_TARGET_PORT=15502

# --- Opsiyonel / varsayılanlar ---
#MANAGEMENT_EVALUATION_INTERVAL_MS=10000
#LOG_LEVEL=info

      "mode": "parallel",
      "steps": [
        {
          "deviceId": "BSC-1",
          "command": "stop"
        },
        {
          "deviceId": "BSC-2",
          "command": "stop"
        }
      ],
      "ui": {
        "hidden": true
      }
    },
    {
      "name": "bsc_stop",
      "label": "BSC Durdur",
      "description": "Uzak operasyon kompanzasyon ad\u0131m\u0131 (field rollback)",
      "mode": "parallel",
      "steps": [
        {
          "deviceIds": [
            "BSC-1",
            "BSC-2"
          ],
          "command": "set_charge_power",
          "params": {
            "powerKw": 0
          }
        },
        {
          "deviceIds": [
            "BSC-1",
            "BSC-2"
          ],
          "command": "set_discharge_power",
          "params": {
            "powerKw": 0
          }
        },
        {
          "deviceIds": [
            "BSC-1",
            "BSC-2"
          ],
          "command": "stop"
        }
      ],
      "ui": {
        "hidden": true
      }
    },
    {
      "name": "bsc_prepare",
      "label": "BSC Haz\u0131rl\u0131k",
      "description": "Kontakt\u00f6rleri kapat + start \u2014 G\u00dc\u00c7 PARAMI YOK (K12: g\u00fc\u00e7 PCS S06'da)",
      "mode": "parallel",
      "onFailure": "stop",
      "steps": [
        {
          "deviceId": "BSC-1",
          "command": "close_contactors"
        },
        {
          "deviceId": "BSC-2",
          "command": "close_contactors"
        },
        {
          "deviceId": "BSC-1",
          "command": "start"
        },
        {
          "deviceId": "BSC-2",
          "command": "start"
        }
      ],
      "rollbackSteps": [
        {
          "deviceId": "BSC-1",
          "command": "stop"
        },
        {
          "deviceId": "BSC-2",
          "command": "stop"
        }
      ],
      "ui": {
        "hidden": true
      }
    }
  ]

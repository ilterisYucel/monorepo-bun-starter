# AWS Edge DEMO stack (v2) — TEK compose ortam şablonu — commit'lenir (sırlar YOK).
# Kopyalayıp doldurun:
#   cp deployment/v2/aws/.env.example deployment/v2/aws/.env
#
# Kullanım:
#   docker compose --env-file deployment/v2/aws/.env -f deployment/v2/aws/docker-compose.yml up -d --build
#   bun run register:aws-demo     # 2 konteyneri birden kaydeder (container-1=bess1, container-2=bess2)
#
# Değişkenler tier'a göre PREFİKSLİDİR (tek compose'da çakışma olmasın):
#   FIELD_*  → field tier      (db: battery)
#   C1_*     → container-1 tier (db: container1)
#   C2_*     → container-2 tier (db: container2)
#
# FLAG (TLS): FIELD_WS_URL ws:// (TLS'siz) — DEMO KABULÜ; üretimde wss:// + ALB/nginx + ACM.

# --- Tek saha kimliği (field + SPA build'e gömülür; geçerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha

# --- Field web-service (>=32 karakter, konteynerlerden FARKLI) ---
#   openssl rand -hex 32
FIELD_JWT_SECRET=
FIELD_SEED_ADMIN_PASSWORD=
FIELD_SEED_BOSS_PASSWORD=
FIELD_SEED_GUEST_PASSWORD=

# --- Container-1 web-service ---
#   openssl rand -hex 32
C1_JWT_SECRET=
C1_SEED_ADMIN_PASSWORD=
C1_SEED_BOSS_PASSWORD=
C1_SEED_GUEST_PASSWORD=
# Field register API'sine kaydedilir (hash saklanır; >=32 karakter)
C1_CONTAINER_TOKEN=

# --- Container-2 web-service ---
#   openssl rand -hex 32
C2_JWT_SECRET=
C2_SEED_ADMIN_PASSWORD=
C2_SEED_BOSS_PASSWORD=
C2_SEED_GUEST_PASSWORD=
C2_CONTAINER_TOKEN=

# --- Ortak ---
# Faz 6: demo'da false (TOTP yok), üretimde true.
MFA_ENABLED=false
# Konteyner → field tüneli (varsayılan açık; kapatılırsa uzak BSC adımları rollback olur).
FIELD_CONNECT_ENABLED=true
# Konteyner→field telemetri push aralığı (ms). Compose varsayılanı 2000 (UI tazeliği);
# ws-tunnel default'u 15000. 1000–300000 aralığına kırpılır.
#TUNNEL_TELEMETRY_INTERVAL_MS=2000
# BSC→PCS connector BMS hedefi (ortak ağ servis adı).
#PCS_BMS_TARGET_HOST=field-device-service
#PCS_BMS_TARGET_PORT=15502

# --- Field → boss uplink (demo-edge standalone: KAPALI) ---
FIELD_UPLINK_ENABLED=false
FIELD_UPLINK_WS_URL=
FIELD_UPLINK_TOKEN=

# --- WS4: field → container komut kanalı (opsiyonel) ---
#   openssl rand -hex 32
FIELD_INTERNAL_API_TOKEN=

# --- EPİAŞ market plugin ---
# Kimlik .env'de DEĞİL; deployment/v2/aws/field/plugins/epias-market-prices.json (gitignored).
# Şablon: plugins/epias-market-prices.example.json. Kimlik yoksa Market boş kalır (uydurma veri YOK).

# --- Opsiyonel / varsayılanlar ---
#FIELD_WS_URL=ws://field-web-service:5002/ws/container
#TUNNEL_FIELD_API_UPSTREAM=http://field-web-service:5002
#TUNNEL_FIELD_STATIC_UPSTREAM=http://field-web:80
#MANAGEMENT_EVALUATION_INTERVAL_MS=10000
#LOG_LEVEL=info

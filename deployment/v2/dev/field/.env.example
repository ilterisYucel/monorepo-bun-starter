# DEMO-FIELD (v2) yerel demo/entegrasyon stack'i — FIELD yarısı ortam şablonu.
# Kopyalayın ve doldurun (sırlar commit'lenmez):
#   cp deployment/v2/dev/field/.env.example deployment/v2/dev/field/.env
#
# SPA: http://localhost:8088 · API: http://localhost:5002
#
# Stack: bun run start:demo-integration   ·   Durdur: bun run stop:demo-integration

# --- Tek saha kimliği (ZORUNLU, geçerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha Demo

# --- Field JWT sırrı (>=32 karakter) ---
#   openssl rand -hex 32
FIELD_JWT_SECRET=
ACCESS_TOKEN_EXPIRY_SECONDS=900
MFA_ENABLED=false

# --- Seed kullanıcı parolaları (>=8 karakter) ---
# Entegrasyon testleri varsayılanı: admin / password123
SEED_ADMIN_PASSWORD=password123
SEED_BOSS_PASSWORD=password123
SEED_GUEST_PASSWORD=password123

# --- Boss uplink — demo standalone, KAPALI ---
FIELD_UPLINK_ENABLED=false
FIELD_UPLINK_WS_URL=
FIELD_UPLINK_TOKEN=

# --- Field → konteyner komut kanalı (opsiyonel) ---
FIELD_INTERNAL_API_TOKEN=

# --- Hub ws-tunnel (field hibrit hub) ---
# Container peer'ları ve agent bu token ile hub'a bağlanır (container .env'lerindeki
# HUB_PEER_TOKEN ile AYNI değer olmalı).
#   openssl rand -hex 32
HUB_PEER_TOKEN=dev-hub-peer-token
# Hub consumer (field web-service + management-service) — peer token'ından AYRI.
HUB_CONSUMER_TOKEN=dev-hub-consumer-token
# Hub-servis imajı (yerelde derlenmiş imaj varsayılanı).
#HUB_IMAGE=ws-tunnel-hub:local

# --- Peer agent (saha SPA'sını hub'a opak servis olarak duyurur) ---
#AGENT_IMAGE=ws-tunnel-agent:local
#AGENT_PEER_ID=demo-field-agent
#AGENT_SERVICE_ID=field-ui
#AGENT_LOCAL_TARGET=http://field-web:80
#AGENT_TLS_INSECURE=0

# --- Opsiyonel ---
MANAGEMENT_EVALUATION_INTERVAL_MS=10000

# Hub modu: konteynerler hub'a kendini duyurur — register adımı YOKTUR.

# DEMO-FIELD (v2) yerel demo/entegrasyon stack'i — FIELD yarısı ortam şablonu.
# Kopyalayın ve doldurun (sırlar commit'lenmez):
#   cp deployment/v2/dev/field/.env.example deployment/v2/dev/field/.env
#
# SPA: http://localhost:8088 · API: http://localhost:5002
#
# Stack: bun run start:demo-integration   ·   Durdur: bun run stop:demo-integration

# --- Tek saha kimliği (ZORUNLU, geçerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha Demo

# --- Field JWT sırrı (>=32 karakter) ---
#   openssl rand -hex 32
FIELD_JWT_SECRET=
ACCESS_TOKEN_EXPIRY_SECONDS=900
MFA_ENABLED=false

# --- Seed kullanıcı parolaları (>=8 karakter) ---
# Entegrasyon testleri varsayılanı: admin / password123
SEED_ADMIN_PASSWORD=password123
SEED_BOSS_PASSWORD=password123
SEED_GUEST_PASSWORD=password123

# --- Boss uplink — demo standalone, KAPALI ---
FIELD_UPLINK_ENABLED=false
FIELD_UPLINK_WS_URL=
FIELD_UPLINK_TOKEN=

# --- Field → konteyner komut kanalı (opsiyonel) ---
FIELD_INTERNAL_API_TOKEN=

# --- Opsiyonel ---
MANAGEMENT_EVALUATION_INTERVAL_MS=10000

# --- İLK KURULUM: konteyneri field'a kaydet (bir kez) ---
# Konteyner WS uplink'i register OLMADAN bağlanamaz (101 reddi). Stack kalktıktan
# sonra (field web-service ayakta):
#   FID=$(grep '^FIELD_ID=' deployment/v2/dev/field/.env | cut -d= -f2)
#   CT=$(grep '^CONTAINER_TOKEN=' deployment/v2/dev/container/.env | cut -d= -f2)
#   T=$(curl -s -X POST http://localhost:5002/api/auth/login -H 'Content-Type: application/json' \
#       -d '{"username":"admin","password":"password123"}' | python3 -c 'import sys,json;print(json.load(sys.stdin)["accessToken"])')
#   # admin ilk girişte parola değiştirir; yeni parola ile tekrar login edip T'yi alın.
#   curl -X POST "http://localhost:5002/api/fields/$FID/containers/container-1/register" \
#       -H "Authorization: Bearer $T" -H 'Content-Type: application/json' -d "{\"token\":\"$CT\"}"
#   docker restart demo-container-web-service   # uplink'i hemen yeniden kurar

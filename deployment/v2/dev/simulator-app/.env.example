# Sim-Lab (simulator-app) ortam değişkenleri — kopyalayın: cp .env.example .env
# Saha dosyası (sites/ altında): gd1.site.json (9 konteyner, 18 PCS) | tek-konteyner.site.json
SIM_SITE_FILE=gd1.site.json
# Gerçeklik profili: uyumlu | gercek
SIM_PROFILE=uyumlu
# Simülasyon hız çarpanı
SIM_SPEED=1
# Export edilen EMS config'lerinde EMS'in simülatöre ulaşacağı adres
SIM_EMS_HOST=host.docker.internal
# Arayüz portu (host)
SIM_HTTP_PORT=8090
TZ=Europe/Istanbul

# Sim-Lab (simulator-app) ortam değişkenleri — kopyalayın: cp .env.example .env
# Saha dosyası (sites/ altında): demo-v2.site.json (v2: 2 konteyner, 4 PCS) |
#   gd1.site.json (9 konteyner, 18 PCS) | tek-konteyner.site.json
SIM_SITE_FILE=demo-v2.site.json
# Gerçeklik profili: uyumlu | gercek
SIM_PROFILE=uyumlu
# Simülasyon hız çarpanı
SIM_SPEED=1
# Export edilen EMS config'lerinde EMS'in simülatöre ulaşacağı adres
# (v2 stack'leri gd-simnet ağı üzerinden servis adıyla bağlanır)
SIM_EMS_HOST=sim-lab
# Arayüz portu (host)
SIM_HTTP_PORT=8090
TZ=Europe/Istanbul

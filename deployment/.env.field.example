# Field stack ortam degiskenleri sablonu — commit'lenir (sirlar YOK).
# Kopyalayip doldurun:  cp .env.field.example .env.field
# Script'ler dosyayi su sekilde kullanir:
#   docker compose --env-file deployment/.env.field -f deployment/docker-compose.field.yml up -d

# Web-service kimlik dogrulamasi (>=32 karakter, rastgele uretin:
#   openssl rand -hex 32)
JWT_SECRET=

# Seed kullanicilarinin ilk parolalari (>=8 karakter).
# Ilk girislerde zorunlu sifre degisimi istenir (Faz 1 T1.6).
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# Tek saha kimligi — field tier'da ZORUNLU (gecerli UUID; uretim: uuidgen).
# Acilista `fields` tablosuna seed edilir — elle saha olusturma gerekmez.
# Ayni deger frontend'e VITE_FIELD_ID olarak da gider (giris sonrasi saha
# cozumu icin — saha listesi endpoint'i field stack'te YOKTUR).
FIELD_ID=
# Saha adi (opsiyonel; yoksa "Saha").
FIELD_NAME=

# Faz 6 T6.1 MFA anahtari: true = zorunlu (URETIM), false = kapali (debug).
MFA_ENABLED=true

# NOT: Konteyner service token'i FIELD tarafinda env ile tutulmaz.
# Token kurulumda URETILIR ve `POST /api/fields/:fieldId/containers/:containerId/register`
# ile field'a kaydedilir (yalnizca SHA-256 hash'i saklanir). Duz metin token
# yalnizca konteyner tarafindaki .env.container dosyasinda bulunur.
#   openssl rand -hex 32

# --- Boss Faz 3: field uplink (opsiyonel) ---
# Field'in boss cloud'a outbound WSS baglantisini etkinlestirir.
FIELD_UPLINK_ENABLED=false
# Boss cloud WS URL listesi (ana+yedek, virgullu).
FIELD_UPLINK_WS_URL=
# Field uplink service token'i — boss tarafinda saha kaydinda (POST /api/admin/fields
# body.uplinkToken) verilir; boss yalnizca SHA-256 hash'ini saklar.
#   openssl rand -hex 32
FIELD_UPLINK_TOKEN=
# Boss'tan gelen field-app tunel akislarinin upstream'leri:
TUNNEL_FIELD_API_UPSTREAM=http://web-service:5001
TUNNEL_FIELD_STATIC_UPSTREAM=http://field-web

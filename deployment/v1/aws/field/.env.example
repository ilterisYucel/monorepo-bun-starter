# AWS Edge (classic stack) — FIELD yarısı ortam şablonu — commit'lenir (sırlar YOK).
# Kopyalayıp doldurun:
#   cp deployment/v1/aws/field/.env.example deployment/v1/aws/field/.env
# Kullanım (önce container ağı tanımlar, sonra field):
#   docker compose --env-file deployment/v1/aws/field/.env -f deployment/v1/aws/field/docker-compose.yml up -d --build

# --- Field web-service kimlik doğrulaması (>=32 karakter, CONTAINER'DAN FARKLI) ---
#   openssl rand -hex 32
FIELD_JWT_SECRET=

# --- Seed kullanıcıları (>=8 karakter) ---
SEED_ADMIN_PASSWORD=
SEED_BOSS_PASSWORD=
SEED_GUEST_PASSWORD=

# --- Tek saha kimliği (field tier ZORUNLU, geçerli UUID) ---
#   uuidgen
FIELD_ID=
FIELD_NAME=Saha

# Faz 6 T6.1 — MFA. FLAG: demo'da false (TOTP yok), üretimde true.
MFA_ENABLED=false

# --- Field → boss uplink (boss YOK ise false) ---
FIELD_UPLINK_ENABLED=false
FIELD_UPLINK_WS_URL=
FIELD_UPLINK_TOKEN=

# --- WS4: field → container komut kanalı (opsiyonel) ---
# Programatik kanal gizli token'ı — web-service ve management-service AYNI değerde olmalı.
#   openssl rand -hex 32
FIELD_INTERNAL_API_TOKEN=

# --- Opsiyonel / varsayılanlar ---
#TUNNEL_FIELD_API_UPSTREAM=http://field-web-service:5002
#TUNNEL_FIELD_STATIC_UPSTREAM=http://field-web:80
#MANAGEMENT_EVALUATION_INTERVAL_MS=10000

{
  "name": "gd-pms-monorepo",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=dev --parallel=5",
    "dev:container-web": "nx run container-web:dev",
    "dev:container-desktop": "nx run container-desktop:dev",
    "dev:container": "docker compose -f deployment/docker-compose.container.dev.yml up",
    "dev:editor": "nx run editor:dev",
    "start:container": "docker compose -f deployment/docker-compose.container.yml up -d",
    "stop:container": "docker compose -f deployment/docker-compose.container.yml down",
    "build": "nx run-many --target=build",
    "build:container-web": "nx run container-web:build",
    "build:container-desktop": "nx run container-desktop:build",
    "test": "vitest",
    "test:unit": "vitest --config vitest.workspace.ts",
    "test:coverage": "vitest --config vitest.workspace.ts --coverage",
    "test:e2e": "playwright test",
    "test:perf": "k6 run deployment/k6/*.js",
    "graph": "nx graph",
    "clean": "nx run-many --target=clean"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@nx/react": "^22.7.1",
    "@nx/vite": "^22.7.1",
    "@types/bun": "latest",
    "nx": "^22.7.1",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/**"
  ]
}

{
  "name": "eslint-plugin-energy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/eslint-plugin-energy/src",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "tools/eslint-plugin-energy"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build src/index.ts --outdir dist --target bun",
        "cwd": "tools/eslint-plugin-energy"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "tools/eslint-plugin-energy"
      }
    }
  }
}

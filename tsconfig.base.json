{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // ===== NX İÇİN EKLENEN AYARLAR =====
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false, // Root'da false, alt projelerde true olacak
    "emitDeclarationOnly": false,
    "noEmit": false, // Base'de false, root'da true olacak

    // ===== MONOREPO PATHS AYARLARI =====
    "paths": {
      "@gd-monorepo/shared-types": ["./packages/shared-types/src"],
      "@gd-monorepo/shared-utils": ["./packages/shared-utils/src"],
      "@gd-monorepo/core": ["./packages/core/src"],
      "@gd-monorepo/container-web": ["./apps/container-web/src"],
      "@gd-monorepo/container-desktop": ["./apps/container-desktop/src"],
      "@gd-monorepo/editor": ["./apps/editor/src"],
      "@gd-monorepo/simulators": ["./packages/simulators/src"],
      "@gd-monorepo/ui": ["./packages/ui/src"],
      "@gd-monorepo/device-library": ["./packages/device-library/src"],
      "@gd-monorepo/field": ["./apps/field/src"],
      "@gd-monorepo/superadmin": ["./apps/superadmin/src"],
      "@gd-monorepo/plugin-sdk": ["./packages/plugin-sdk/src"],
      "@gd-monorepo/epias-market-prices": ["./packages/plugins/epias-market-prices/src"]
    }
  },
  "exclude": ["node_modules", "dist", "out", "release", "**/dist", "**/out"]
}

    {
      "name": "tms_overheat_protect",
      "cooldownMs": 900000,
      "when": {
        "any": [
          {
            "telemetry": "Current Temp",
            "op": "gt",
            "threshold": 29,
            "device": {
              "types": [
                "hvac"
              ]
            },
            "debounceMs": 900000
          },
          {
            "telemetry": "Max Pack Temp",
            "op": "gt",
            "threshold": 50,
            "device": {
              "types": [
                "bsc"
              ]
            },
            "debounceMs": 300000
          },
          {
            "telemetry": "Max Pack Temp",
            "op": "gt",
            "threshold": 75,
            "device": {
              "types": [
                "bsc"
              ]
            },
            "debounceMs": 45000
          }
        ]
      },

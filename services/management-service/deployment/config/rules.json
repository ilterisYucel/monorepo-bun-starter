{
  "rules": [
    {
      "name": "tms_cool_on_h1",
      "cooldownMs": 60000,
      "when": {
        "all": [
          {
            "telemetry": "Current Temp",
            "op": "gte",
            "threshold": 25,
            "device": {
              "ids": [
                "HVAC-1"
              ]
            }
          }
        ]
      },
      "then": [
        {
          "action": "command",
          "deviceId": "HVAC-1",
          "command": "force_cool"
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "auto_rule_tms_cool_on"
        }
      ]
    },
    {
      "name": "tms_cool_off_h1",
      "cooldownMs": 60000,
      "when": {
        "all": [
          {
            "telemetry": "Current Temp",
            "op": "lt",
            "threshold": 23,
            "device": {
              "ids": [
                "HVAC-1"
              ]
            }
          }
        ]
      },
      "then": [
        {
          "action": "command",
          "deviceId": "HVAC-1",
          "command": "on"
        },
        {
          "action": "log",
          "level": "info",
          "eventCode": "auto_rule_tms_cool_off"

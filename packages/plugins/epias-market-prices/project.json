{
  "name": "epias-market-prices",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/plugins/epias-market-prices/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/plugins/epias-market-prices"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/plugins/epias-market-prices"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "packages/plugins/epias-market-prices"
      }
    }
  },
  "implicitDependencies": [
    "shared-types",
    "plugin-sdk",
    "epias-client"
  ]
}

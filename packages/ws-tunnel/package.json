{
  "name": "@gd-monorepo/ws-tunnel",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/ws": "^8.0.0",
    "jose": "^5.0.0"
  }
}

.sonarlint/

# ============================================
# MISC
# ============================================
*.log
*.tgz
*.gz
.claude/worktrees
.claude/settings.local.json
# tsc build artıkları (composite projelerde src içine yanlışlıkla emit olabilir)
**/src/**/*.d.ts
**/src/**/*.d.ts.map
# istisna: bun-serialport 0.2.0 tip taşımıyor — el yazımı modül bildirimi (build çıktısı değil)
!packages/core/src/modbus/bun-serialport.d.ts

# ============================================
# SECRETS — deployment/servis konfigürasyonları
# ============================================
# Gerçek tier env'leri compose'un yanında yaşar (deployment/<site>/<tier>/.env)
deployment/**/.env
# EPİAŞ canlı kimlik bilgileri (example şablonu commit'lidir)
deployment/**/plugins/epias-market-prices.json

# Sim-Lab EMS config export çıktısı (apps/sim-lab export-ems-config ile yeniden üretilir)
deployment/simlab/
